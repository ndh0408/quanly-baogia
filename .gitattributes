# Normalize line endings on commit; checkout native per-OS.
* text=auto

# Force LF for source/config so Windows autocrlf doesn't churn diffs.
*.js   text eol=lf
*.mjs  text eol=lf
*.cjs  text eol=lf
*.ts   text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.sql  text eol=lf
*.sh   text eol=lf
*.tpl  text eol=lf
# Snapshot của vitest: vitest ghi lại tệp bằng LF. Checkout CRLF (autocrlf trên Windows) thì mỗi lượt
# test excel-snapshot làm git báo `M` dù nội dung y hệt — và verify-local chỉ ghi dấu xanh (cổng
# deploy prod) khi cây SẠCH, nên deploy bị chặn oan. Ép LF để tệp vitest ghi ra trùng từng byte.
*.snap text eol=lf
.editorconfig    text eol=lf
.gitattributes   text eol=lf
.gitignore       text eol=lf
.dockerignore    text eol=lf
Dockerfile       text eol=lf

# Windows scripts keep CRLF.
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binary assets — never normalize, never diff as text.
*.xlsx binary
*.xls  binary
*.pdf  binary
*.ttf  binary
*.otf  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff  binary
*.woff2 binary

# `git archive` (deploy.sh ship mã bằng lệnh này) tự điền mã commit + giờ commit vào tệp → máy chủ biết mình
# đang chạy bản nào để HIỆN cho người dùng (src/phienBan.ts). Cây làm việc thì tệp giữ nguyên $Format:…$.
public/.phien-ban text eol=lf export-subst
