{
  "name": "quanly-baogia",
  "version": "1.0.0",
  "description": "He thong quan ly bao gia Gia Nguyen",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "build:clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && npm run build",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "web:build": "npm --prefix web ci && npm --prefix web run build",
    "web:test": "npm --prefix web run test",
    "db:push": "node -e \"console.error('db push KHÔNG dùng trong repo này — nó xoá được cột và dữ liệu, không có lịch sử để soát. Dùng: npm run db:migrate (dev) / npm run db:migrate:deploy (prod). Xem prisma/migrations/README.md.'); process.exit(1)\"",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:seed:venues": "node prisma/seed-venues.js",
    "db:studio": "prisma studio",
    "setup": "prisma migrate deploy && node prisma/seed.js",
    "verify": "bash scripts/verify-local.sh",
    "verify:nhanh": "bash scripts/verify-local.sh --nhanh",
    "smoke:image": "bash scripts/ci/docker-smoke.sh",
    "smoke:ui": "node scripts/ci/ui-smoke.mjs",
    "scan": "bash scripts/ci/security-scan.sh",
    "scan:secrets": "env SCAN_CHI=secrets bash scripts/ci/security-scan.sh",
    "sbom": "env SCAN_CHI=sbom bash scripts/ci/security-scan.sh",
    "test:toast": "DO_TOAST_MEASURE=1 vitest run tests/b2-update-quote-no-image-read.test.js && DO_TOAST_MEASURE=1 vitest run tests/db3-snapshot-no-images.test.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "qa:dev": "node scripts/dev/rc-qa.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky || true",
    "security:scan": "codex-security scan .",
    "security:scan:deep": "codex-security scan . --mode deep",
    "security:scan:diff": "codex-security scan . --working-tree",
    "security:scan:dry": "codex-security scan . --dry-run",
    "format": "prettier --write .",
    "pii:backfill": "node --import tsx scripts/migration/pii-backfill.mjs",
    "pii:backfill:dry": "node --import tsx scripts/migration/pii-backfill.mjs --dry-run",
    "pii:verify": "node --import tsx scripts/migration/pii-backfill.mjs --verify",
    "proof:migrate": "node --import tsx scripts/migration/payment-proof-migrate.mjs",
    "proof:migrate:dry": "node --import tsx scripts/migration/payment-proof-migrate.mjs --dry-run",
    "proof:verify": "node --import tsx scripts/migration/payment-proof-migrate.mjs --verify",
    "check:refs": "node scripts/ci/check-line-refs.mjs",
    "check:docnum": "node scripts/ci/check-doc-numbers.mjs --check",
    "docnum": "node scripts/ci/check-doc-numbers.mjs",
    "check:helm": "node scripts/ci/check-helm.mjs",
    "check:alerts": "node scripts/ci/check-alerts.mjs",
    "check:changelog": "node scripts/ci/gen-changelog.mjs --check",
    "check:shell": "node scripts/ci/check-shell-strict.mjs",
    "check:deps": "node scripts/ci/check-deps.mjs",
    "check:web-bundle": "node scripts/ci/check-web-bundle.mjs",
    "check:arch": "node scripts/ci/check-architecture.mjs",
    "db:explain": "node scripts/db/explain-hot-paths.mjs",
    "bench:quote-save": "node scripts/bench/quote-save-bench.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "license": "UNLICENSED",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sentry/node": "^10.72.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.77.6",
    "compression": "^1.8.1",
    "connect-pg-simple": "^9.0.1",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.18.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "nodemailer": "^9.0.6",
    "pdfkit": "^0.20.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.10.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^5.0.0",
    "speakeasy": "^2.0.0",
    "tsx": "^4.23.12",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@openai/codex-security": "^0.1.23",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.19.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/speakeasy": "^2.0.10",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "@opentelemetry/core": "^2.8.0",
    "uuid": "^11.1.1",
    "deepmerge-ts": "^8.0.2"
  }
}
